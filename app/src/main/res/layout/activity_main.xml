<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Header Section -->
            <ImageView
                android:id="@+id/userIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_user"
                android:contentDescription="User"
                android:padding="8dp"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Task Tracking"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginStart="12dp"
                app:layout_constraintTop_toTopOf="@id/userIcon"
                app:layout_constraintStart_toEndOf="@id/userIcon" />

            <TextView
                android:id="@+id/headerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="January 10, 2025 (5 Task)"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/headerTitle"
                app:layout_constraintStart_toStartOf="@id/headerTitle" />

            <ImageView
                android:id="@+id/bellIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_bell"
                android:contentDescription="Notifications"
                android:padding="4dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toTopOf="@id/userIcon"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Calendar View -->
            <HorizontalScrollView
                android:id="@+id/calendarScrollView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:scrollbars="none"
                app:layout_constraintTop_toBottomOf="@id/headerSubtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:id="@+id/calendarContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/date7"
                        android:layout_width="48dp"
                        android:layout_height="64dp"
                        android:text="7\nSun"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:padding="8dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/date8"
                        android:layout_width="48dp"
                        android:layout_height="64dp"
                        android:text="8\nMon"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:padding="8dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/date9"
                        android:layout_width="48dp"
                        android:layout_height="64dp"
                        android:text="9\nTue"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:padding="8dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/date10"
                        android:layout_width="48dp"
                        android:layout_height="64dp"
                        android:text="10\nThu"
                        android:textSize="12sp"
                        android:textColor="@color/priority_high_text"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:padding="8dp"
                        android:background="@drawable/bg_calendar_selected"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/date11"
                        android:layout_width="48dp"
                        android:layout_height="64dp"
                        android:text="11\nFri"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:padding="8dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/date12"
                        android:layout_width="48dp"
                        android:layout_height="64dp"
                        android:text="12\nSat"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:padding="8dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/date13"
                        android:layout_width="48dp"
                        android:layout_height="64dp"
                        android:text="13\nSun"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:padding="8dp" />

                </LinearLayout>

            </HorizontalScrollView>

            <!-- Task Filters -->
            <HorizontalScrollView
                android:id="@+id/filtersScrollView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:scrollbars="none"
                app:layout_constraintTop_toBottomOf="@id/calendarScrollView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:id="@+id/filtersContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/filterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All Task"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:background="@drawable/bg_filter_selected"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/filterOngoing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="On Going"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:background="@drawable/bg_filter_unselected"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/filterCompleted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Completed"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:background="@drawable/bg_filter_unselected"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/filterPostponed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Postponed"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:background="@drawable/bg_filter_unselected" />

                </LinearLayout>

            </HorizontalScrollView>

            <!-- Task Cards RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tasksRecyclerView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/filtersScrollView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:listitem="@layout/item_task_card" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
